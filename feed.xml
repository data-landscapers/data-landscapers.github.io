---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>

    {% for item in site.posts limit:20 %}
    <item>
      <title>{{ item.title | xml_escape }}</title>
      <link>{{ item.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ item.url | absolute_url }}</guid>
      <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
      {% if item.description %}
      <description>{{ item.description | xml_escape }}</description>
      {% elsif item.subtitle %}
      <description>{{ item.subtitle | xml_escape }}</description>
      {% elsif item.summary %}
      <description>{{ item.summary | xml_escape }}</description>
      {% else %}
      <description>{{ item.content | strip_html | truncate: 280 | xml_escape }}</description>
      {% endif %}
      {% if item.tags %}
      {% for tag in item.tags %}
      <category>{{ tag | xml_escape }}</category>
      {% endfor %}
      {% endif %}
    </item>
    {% endfor %}

  </channel>
</rss>
